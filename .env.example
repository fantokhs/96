# ─── Supabase (required in production / Vercel) ───────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only — never expose. Used by API routes to read/write game state.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Content manager PIN (/admin/content) ─────────────────────────────────
# Required in production. In local development it defaults to 9696.
ADMIN_PIN=change-me

# Leave all Supabase values empty to run locally with the in-memory store
# (single process only — good for trying the game on one machine / LAN).
